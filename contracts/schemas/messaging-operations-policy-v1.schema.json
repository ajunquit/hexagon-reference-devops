{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexagon.ec/schemas/messaging-operations-policy-v1.schema.json",
  "title": "MessagingOperationsPolicy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "product", "environment", "provider", "notificationTargets", "operatorIdentities", "consumers"],
  "properties": {
    "$schema": { "type": "string" },
    "apiVersion": { "const": "hexagon.ec/messaging-operations-policy/v1" },
    "kind": { "const": "MessagingOperationsPolicy" },
    "product": { "$ref": "#/$defs/id" },
    "environment": { "enum": ["dev", "staging", "prod"] },
    "provider": { "enum": ["azure-service-bus", "aws-sns-sqs", "rabbitmq"] },
    "operatorIdentities": {
      "type": "object", "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9+=,.@_-]{0,127}$" }
    },
    "notificationTargets": {
      "type": "array", "uniqueItems": true, "maxItems": 5,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "consumers": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "backlogThreshold", "deadLetterThreshold", "oldestMessageAgeSeconds", "quarantineReviewHours", "replay"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "backlogThreshold": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
          "deadLetterThreshold": { "type": ["integer", "null"], "minimum": 1, "maximum": 1000000000 },
          "oldestMessageAgeSeconds": { "type": ["integer", "null"], "minimum": 60, "maximum": 1209600 },
          "quarantineReviewHours": { "type": "integer", "minimum": 0, "maximum": 168 },
          "replay": {
            "type": "object", "additionalProperties": false,
            "required": ["enabled", "maxBatchSize", "delayMilliseconds"],
            "properties": {
              "enabled": { "type": "boolean" },
              "maxBatchSize": { "type": "integer", "minimum": 1, "maximum": 100 },
              "delayMilliseconds": { "type": "integer", "minimum": 100, "maximum": 10000 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" }
  }
}
