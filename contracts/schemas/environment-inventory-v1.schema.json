{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hexagon:environment-inventory:v1",
  "type": "object", "additionalProperties": false,
  "required": ["apiVersion", "kind", "product", "environment", "instance", "target", "iac", "descriptorSha256", "releaseSha256", "components", "dataPolicy", "revision", "applicationVerified", "roots"],
  "properties": {
    "apiVersion": { "const": "hexagon.ec/environment-inventory/v1" }, "kind": { "const": "EnvironmentInventory" },
    "product": { "type": "string", "pattern": "^hexagon-[a-z][a-z0-9-]*$" },
    "environment": { "enum": ["dev", "staging", "prod"] },
    "instance": { "type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": { "kind": { "enum": ["Ephemeral", "Persistent"] }, "id": { "type": "string", "pattern": "^(?:run-[1-9][0-9]*-[1-9][0-9]*|persistent)$" } } },
    "target": { "oneOf": [{ "$ref": "#/$defs/azureTarget" }, { "$ref": "#/$defs/awsTarget" }] },
    "iac": { "type": "object", "additionalProperties": false, "required": ["repository", "commit", "snapshotSha256"], "properties": { "repository": { "type": "string", "pattern": "^[A-Za-z0-9-]+/hexagon-[a-z][a-z0-9-]*-devops$" }, "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "snapshotSha256": { "$ref": "#/$defs/hash" } } },
    "descriptorSha256": { "$ref": "#/$defs/hash" }, "releaseSha256": { "$ref": "#/$defs/hash" },
    "components": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "enum": ["web", "backend"] } },
    "dataPolicy": { "enum": ["DeleteEphemeral", "BackupRequired"] },
    "revision": { "type": "integer", "minimum": 0 }, "applicationVerified": { "const": false },
    "roots": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "$ref": "#/$defs/root" } }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "azureTarget": {
      "type": "object", "additionalProperties": false, "required": ["tenantId", "subscriptionId", "clientId", "stateResourceGroup", "storageAccount", "container"],
      "properties": { "tenantId": { "$ref": "#/$defs/uuid" }, "subscriptionId": { "$ref": "#/$defs/uuid" }, "clientId": { "$ref": "#/$defs/uuid" }, "stateResourceGroup": { "type": "string", "pattern": "^rg-[a-z0-9-]{1,76}$" }, "storageAccount": { "type": "string", "pattern": "^[a-z0-9]{3,24}$" }, "container": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,61}[a-z0-9]$" } }
    },
    "awsTarget": {
      "type": "object", "additionalProperties": false, "required": ["accountId", "region", "roleArn", "stateBucket", "stateKmsKeyArn"],
      "properties": { "accountId": { "type": "string", "pattern": "^[0-9]{12}$" }, "region": { "type": "string", "pattern": "^[a-z]{2}(-[a-z]+)+-[0-9]$" }, "roleArn": { "type": "string", "pattern": "^arn:aws:iam::[0-9]{12}:role/[A-Za-z0-9+=,.@_-]{1,64}$" }, "stateBucket": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$" }, "stateKmsKeyArn": { "type": "string", "pattern": "^arn:aws:kms:[a-z0-9-]+:[0-9]{12}:key/[0-9a-f-]{36}$" } }
    },
    "root": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "adapter", "dependsOn", "stateKey", "configurationSha256", "inputsSha256", "status", "lastOperation", "stateLineage", "stateSerial", "resources", "plan", "errorCode"],
      "properties": {
        "id": { "enum": ["hosting", "messaging"] }, "adapter": { "enum": ["AzureHosting", "AzureServiceBus", "AwsHosting", "AwsSnsSqs"] },
        "dependsOn": { "type": "array", "maxItems": 1, "uniqueItems": true, "items": { "enum": ["hosting", "messaging"] } },
        "resourceGroup": { "type": "string", "pattern": "^rg-[a-z0-9-]{1,76}$" },
        "namePrefix": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,18}$" },
        "stateKey": { "type": "string", "pattern": "^hexagon-[a-z0-9-]+/(dev|staging|prod)/(run-[1-9][0-9]*-[1-9][0-9]*|persistent)/(hosting|messaging)[.]tfstate$" },
        "configurationSha256": { "$ref": "#/$defs/hash" }, "inputsSha256": { "$ref": "#/$defs/hash" },
        "status": { "enum": ["Pending", "Planned", "Applying", "Verified", "Destroying", "Destroyed", "Failed"] },
        "lastOperation": { "enum": [null, "Create", "Destroy"] },
        "stateLineage": { "type": ["string", "null"], "pattern": "^[0-9a-f-]{36}$" }, "stateSerial": { "type": "integer", "minimum": 0 },
        "resources": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/resource" } },
        "plan": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/plan" }] },
        "errorCode": { "type": ["string", "null"], "pattern": "^lifecycle[.][A-Za-z0-9.]+$" }
      },
      "if": { "properties": { "adapter": { "enum": ["AzureHosting", "AzureServiceBus"] } } },
      "then": { "required": ["resourceGroup"], "not": { "required": ["namePrefix"] } },
      "else": { "required": ["namePrefix"], "not": { "required": ["resourceGroup"] } }
    },
    "resource": {
      "type": "object", "additionalProperties": false, "required": ["id", "address", "type", "presence", "current"],
      "properties": { "id": { "type": "string", "maxLength": 2048, "anyOf": [{ "pattern": "^/subscriptions/[0-9a-f-]{36}/resourceGroups/[^/]+/providers/[^ ]+$" }, { "pattern": "^aws:[0-9]{12}:[a-z]{2}(-[a-z]+)+-[0-9]:aws_[a-z0-9_]+:[^ ]+$" }] }, "address": { "type": "string", "minLength": 1, "maxLength": 512 }, "type": { "type": "string", "pattern": "^(azurerm|aws)_[a-z0-9_]+$" }, "presence": { "enum": ["Present", "Missing", "Unknown"] }, "current": { "type": "boolean" } }
    },
    "plan": {
      "type": "object", "additionalProperties": false,
      "required": ["rootId", "operation", "binarySha256", "jsonSha256", "bindingSha256", "revision", "createdAt", "reviewSha256"],
      "properties": { "rootId": { "enum": ["hosting", "messaging"] }, "operation": { "enum": ["Create", "Destroy"] }, "binarySha256": { "$ref": "#/$defs/hash" }, "jsonSha256": { "$ref": "#/$defs/hash" }, "bindingSha256": { "$ref": "#/$defs/hash" }, "revision": { "type": "integer", "minimum": 1 }, "createdAt": { "type": "integer", "minimum": 0 }, "reviewSha256": { "$ref": "#/$defs/hash" } }
    }
  }
}
