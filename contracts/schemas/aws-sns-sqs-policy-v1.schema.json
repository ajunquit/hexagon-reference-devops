{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hexagon:aws-sns-sqs-policy:v1",
  "title": "Hexagon AWS SNS/SQS policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "apiVersion",
    "kind",
    "product",
    "environment",
    "region",
    "kmsAliasName",
    "destinations",
    "consumers",
    "workloadRoleNames"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "pattern": "^(?:\\.\\./)+contracts/schemas/aws-sns-sqs-policy-v1\\.schema\\.json$"
    },
    "apiVersion": {
      "const": "hexagon.ec/aws-sns-sqs-policy/v1"
    },
    "kind": {
      "const": "AwsSnsSqsPolicy"
    },
    "product": {
      "$ref": "#/$defs/product"
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "region": {
      "type": "string",
      "pattern": "^[a-z]{2}(?:-gov)?-[a-z]+-[0-9]+$"
    },
    "kmsAliasName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!alias/)[A-Za-z0-9/_-]+$"
    },
    "tags": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "destinations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/destination"
      }
    },
    "consumers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/consumer"
      }
    },
    "workloadRoleNames": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/workload"
      },
      "additionalProperties": {
        "$ref": "#/$defs/roleName"
      }
    }
  },
  "$defs": {
    "product": {
      "type": "string",
      "pattern": "^hexagon-[a-z][a-z0-9-]*$"
    },
    "environment": {
      "enum": [
        "dev",
        "staging",
        "prod"
      ]
    },
    "logicalId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "workload": {
      "type": "string",
      "pattern": "^hexagon-[a-z][a-z0-9-]*$"
    },
    "topicName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "queueName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "roleName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9+=,.@_-]+$"
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "topicName"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/logicalId"
        },
        "topicName": {
          "$ref": "#/$defs/topicName"
        }
      }
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "queueName",
        "visibilityTimeoutSeconds",
        "messageRetentionSeconds",
        "receiveMessageWaitTimeSeconds",
        "retryVisibilityTimeoutSeconds",
        "redrive"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/logicalId"
        },
        "queueName": {
          "$ref": "#/$defs/queueName"
        },
        "visibilityTimeoutSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 43200
        },
        "messageRetentionSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 1209600
        },
        "receiveMessageWaitTimeSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "retryVisibilityTimeoutSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 43200
        },
        "redrive": {
          "$ref": "#/$defs/redrive"
        }
      }
    },
    "redrive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "deadLetterQueueName": {
          "$ref": "#/$defs/queueName"
        },
        "maxReceiveCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "deadLetterMessageRetentionSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 1209600
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "required": [
              "deadLetterQueueName",
              "maxReceiveCount",
              "deadLetterMessageRetentionSeconds"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "deadLetterQueueName"
                  ]
                },
                {
                  "required": [
                    "maxReceiveCount"
                  ]
                },
                {
                  "required": [
                    "deadLetterMessageRetentionSeconds"
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  }
}
