{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["apiVersion", "kind", "product", "environment", "authority", "resourceServer", "frontend", "authorizationClientId"],
  "properties": {
    "apiVersion": { "const": "hexagon.ec/keycloak-authorization/v1" },
    "kind": { "const": "KeycloakAuthorization" },
    "product": { "type": "string", "pattern": "^hexagon-[a-z][a-z0-9-]{1,50}$" },
    "environment": { "enum": ["local", "dev", "staging", "prod"] },
    "authority": { "type": "string", "pattern": "^https://[A-Za-z0-9.-]+(?::[0-9]+)?(?:/[a-z][a-z0-9-]{0,62})*/realms/[a-z][a-z0-9-]{0,62}$" },
    "resourceServer": {
      "type": "object", "additionalProperties": false, "required": ["id", "clientId", "apiScope"],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$" },
        "clientId": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,100}$" },
        "apiScope": { "type": "string", "pattern": "^[a-z][a-z0-9_.:-]{2,120}$" }
      }
    },
    "authorizationClientId": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,100}$" },
    "frontend": {
      "type": "object", "additionalProperties": false, "required": ["clientId", "origins"],
      "properties": {
        "clientId": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,100}$" },
        "origins": { "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^https?://[A-Za-z0-9.-]+(?::[0-9]+)?$" } }
      }
    }
  }
}
