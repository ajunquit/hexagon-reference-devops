{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "apiVersion",
    "kind",
    "product",
    "environment",
    "infrastructure",
    "workloads"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "pattern": "^(?:\\.\\./)+contracts/schemas/aws-hosting-policy-v1\\.schema\\.json$"
    },
    "apiVersion": {
      "const": "hexagon.ec/aws-hosting-policy/v1"
    },
    "kind": {
      "const": "AwsHostingPolicy"
    },
    "product": {
      "type": "string",
      "pattern": "^hexagon-[a-z][a-z0-9-]*$"
    },
    "environment": {
      "enum": [
        "dev",
        "staging",
        "prod"
      ]
    },
    "infrastructure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account_id",
        "region",
        "name_prefix",
        "availability_zones",
        "vpc_cidr",
        "public_subnet_cidrs",
        "database_subnet_cidrs",
        "database_name",
        "auth",
        "tags"
      ],
      "properties": {
        "account_id": {
          "type": "string",
          "pattern": "^[0-9]{12}$"
        },
        "region": {
          "type": "string",
          "pattern": "^[a-z]{2}(-[a-z]+)+-[0-9]$"
        },
        "name_prefix": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,18}$"
        },
        "availability_zones": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2}(-[a-z]+)+-[0-9][a-z]$"
          },
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        },
        "vpc_cidr": {
          "type": "string",
          "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/[0-9]{1,2}$"
        },
        "public_subnet_cidrs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/[0-9]{1,2}$"
          },
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        },
        "database_subnet_cidrs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/[0-9]{1,2}$"
          },
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        },
        "database_name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,62}$"
        },
        "database_instance_class": {
          "type": "string",
          "pattern": "^db\\.[a-z0-9]+\\.[a-z0-9]+$"
        },
        "database_storage_gb": {
          "type": "integer",
          "minimum": 20
        },
        "database_multi_az": {
          "type": "boolean"
        },
        "log_retention_days": {
          "enum": [
            1,
            3,
            5,
            7,
            14,
            30,
            60,
            90
          ]
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authority",
            "client_id"
          ],
          "properties": {
            "authority": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^https://[A-Za-z0-9.-]+/[^?#@]+[^/]$"
            },
            "client_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]+$"
            }
          }
        },
        "tags": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "acceptance_fixture": {
          "type": "object",
          "required": [
            "instanceId",
            "subjectId",
            "tenant",
            "otherTenant"
          ],
          "additionalProperties": false,
          "properties": {
            "otherTenant": {
              "type": "string",
              "pattern": "^e2e-run-[1-9][0-9]*-[1-9][0-9]*-b$"
            },
            "tenant": {
              "type": "string",
              "pattern": "^e2e-run-[1-9][0-9]*-[1-9][0-9]*-a$"
            },
            "subjectId": {
              "type": "string",
              "format": "uuid"
            },
            "instanceId": {
              "type": "string",
              "pattern": "^run-[1-9][0-9]{0,19}-[1-9][0-9]{0,3}$"
            }
          }
        },
        "keycloak": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "image",
            "realm",
            "bootstrap_user"
          ],
          "properties": {
            "image": {
              "type": "string",
              "pattern": "^quay\\.io/keycloak/keycloak@sha256:[0-9a-f]{64}$"
            },
            "realm": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,62}$",
              "not": {
                "const": "master"
              }
            },
            "bootstrap_user": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,62}$"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "keycloak"
            ]
          },
          "then": {
            "properties": {
              "auth": {
                "properties": {
                  "authority": {
                    "type": "null"
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "auth": {
                "properties": {
                  "authority": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "workloads": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,62}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "cpu",
          "memory",
          "min_replicas",
          "max_replicas",
          "environment",
          "secret_references"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,30}[a-z0-9]$"
          },
          "cpu": {
            "description": "Fargate CPU units.",
            "enum": [
              256,
              512,
              1024,
              2048
            ]
          },
          "memory": {
            "description": "Fargate memory in MiB, valid for its CPU.",
            "type": "integer",
            "minimum": 512
          },
          "min_replicas": {
            "type": "integer",
            "minimum": 1
          },
          "max_replicas": {
            "type": "integer",
            "minimum": 1
          },
          "environment": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "secret_references": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "secret_arn"
              ],
              "properties": {
                "secret_arn": {
                  "type": "string",
                  "pattern": "^arn:aws:secretsmanager:[a-z0-9-]+:[0-9]{12}:secret:[A-Za-z0-9/_+=.@-]+$"
                }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "infrastructure": {
            "required": [
              "keycloak"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "environment": {
            "const": "dev"
          }
        }
      }
    }
  ]
}
