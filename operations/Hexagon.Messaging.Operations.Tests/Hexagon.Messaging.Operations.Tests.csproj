<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="Testcontainers.RabbitMq" />
    <ProjectReference Include="../Hexagon.Messaging.Operations/Hexagon.Messaging.Operations.csproj" />
    <ProjectReference Include="../Hexagon.Database.Bootstrap/Hexagon.Database.Bootstrap.csproj" />
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>
  <!-- The SDKs of each cloud (docs/separacion-por-nube.md): every template brings only its own file. -->
  <Import Project="$(MSBuildThisFileDirectory)Cloud.*.props" />
</Project>
